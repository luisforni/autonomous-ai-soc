# ============================================================
# AI-SOC Configuration
# ============================================================

# Application
APP_NAME="AI-SOC"
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change_this_secret_key_in_production
API_VERSION=v1

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ============================================================
# AI Provider — elige uno:
# anthropic | openai | azure_openai | gemini | aws_bedrock |
# mistral | groq | cohere | together | perplexity |
# ollama | lm_studio | vllm | llamacpp
# ============================================================
AI_PROVIDER=ollama
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.1

# -----------------------------------------------------------------------
# Anthropic (Claude)
# -----------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-opus-4-8

# -----------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# -----------------------------------------------------------------------
# Azure OpenAI
# -----------------------------------------------------------------------
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# -----------------------------------------------------------------------
# Google Gemini
# -----------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# -----------------------------------------------------------------------
# AWS Bedrock
# -----------------------------------------------------------------------
BEDROCK_MODEL_ID=anthropic.claude-opus-4-8-v1:0

# -----------------------------------------------------------------------
# Mistral
# -----------------------------------------------------------------------
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-large-latest

# -----------------------------------------------------------------------
# Groq
# -----------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------
# Cohere
# -----------------------------------------------------------------------
COHERE_API_KEY=your_cohere_api_key_here
COHERE_MODEL=command-r-plus

# -----------------------------------------------------------------------
# Together AI
# -----------------------------------------------------------------------
TOGETHER_API_KEY=your_together_api_key_here
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# -----------------------------------------------------------------------
# Perplexity
# -----------------------------------------------------------------------
PERPLEXITY_API_KEY=your_perplexity_api_key_here
PERPLEXITY_MODEL=llama-3.1-sonar-large-128k-online

# -----------------------------------------------------------------------
# Ollama (local — ollama pull llama3.3)
# -----------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.3

# -----------------------------------------------------------------------
# LM Studio (local)
# -----------------------------------------------------------------------
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=lmstudio-community/Meta-Llama-3.1-8B-Instruct-GGUF

# -----------------------------------------------------------------------
# vLLM (local)
# -----------------------------------------------------------------------
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=meta-llama/Llama-3.3-70B-Instruct

# -----------------------------------------------------------------------
# llama.cpp (local)
# -----------------------------------------------------------------------
LLAMACPP_BASE_URL=http://localhost:8080/v1
LLAMACPP_MODEL=llama-3.3-70b

# ============================================================
# Databases (docker-compose usa estos por defecto)
# ============================================================
DATABASE_URL=postgresql+asyncpg://soc:soc@postgres:5432/aisoc
DATABASE_POOL_SIZE=20
REDIS_URL=redis://redis:6379/0
REDIS_POOL_SIZE=10
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX_PREFIX=aisoc

# ============================================================
# Message Queue
# ============================================================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_ALERTS=aisoc.alerts
KAFKA_TOPIC_EVENTS=aisoc.events
KAFKA_TOPIC_INCIDENTS=aisoc.incidents

# ============================================================
# SIEM
# ============================================================
SPLUNK_HOST=
SPLUNK_PORT=8089
SPLUNK_TOKEN=
SPLUNK_INDEX=main
ELASTIC_SIEM_URL=http://elasticsearch:9200
ELASTIC_SIEM_API_KEY=
QRADAR_HOST=
QRADAR_TOKEN=
AZURE_SENTINEL_WORKSPACE_ID=
AZURE_SENTINEL_PRIMARY_KEY=

# ============================================================
# Cloud Providers
# ============================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_GUARDDUTY_DETECTOR_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GCP_PROJECT_ID=
GCP_CREDENTIALS_FILE=

# ============================================================
# Threat Intelligence
# ============================================================
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
MISP_URL=
MISP_KEY=
ABUSEIPDB_API_KEY=
ALIENVAULT_OTX_KEY=

# ============================================================
# Ticketing & Notifications
# ============================================================
JIRA_URL=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_PROJECT_KEY=SOC
SERVICENOW_URL=
SERVICENOW_USER=
SERVICENOW_PASSWORD=
PAGERDUTY_INTEGRATION_KEY=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ALERTS=#soc-alerts
SLACK_CHANNEL_CRITICAL=#soc-critical
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=soc@yourcompany.com

# ============================================================
# Auth
# ============================================================
JWT_SECRET_KEY=change_this_jwt_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# Monitoring
# ============================================================
PROMETHEUS_PORT=9090
GRAFANA_URL=http://localhost:3001
GRAFANA_API_KEY=

# ============================================================
# Rate Limiting
# ============================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
CORS_ORIGINS=["http://localhost:3000"]

# ============================================================
# Agent Configuration
# ============================================================
AGENT_MAX_CONCURRENT=20
AGENT_TIMEOUT_SECONDS=300
AGENT_RETRY_ATTEMPTS=3
AGENT_RETRY_DELAY=5
